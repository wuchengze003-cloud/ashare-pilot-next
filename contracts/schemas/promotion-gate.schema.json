{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ashare-pilot.local/promotion-gate/1.0.0",
  "title": "Promotion Gate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "schema_version",
    "gate_id",
    "maximum_drawdown",
    "minimum_trades",
    "minimum_sharpe",
    "maximum_top_trade_profit_share",
    "require_untouched_final_window"
  ],
  "properties": {
    "contract_id": {"const": "promotion-gate"},
    "schema_version": {"const": "1.0.0"},
    "gate_id": {"type": "string", "pattern": "^[a-z0-9-]+/v[0-9]+$"},
    "maximum_drawdown": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "minimum_trades": {"type": "integer", "minimum": 1},
    "minimum_sharpe": {"type": "number"},
    "maximum_top_trade_profit_share": {"type": "number", "minimum": 0, "maximum": 1},
    "require_untouched_final_window": {"const": true}
  }
}
