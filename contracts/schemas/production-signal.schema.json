{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ashare-pilot.local/production-signal/3.0.0",
  "title": "Production Signal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "schema_version",
    "signal_id",
    "state",
    "as_of",
    "latest_complete_date",
    "generated_at",
    "champion",
    "previous_signal_sha256",
    "target_positions",
    "reason_codes",
    "contract_set"
  ],
  "properties": {
    "contract_id": {"const": "production-signal"},
    "schema_version": {"const": "3.0.0"},
    "signal_id": {"type": "string", "minLength": 3, "maxLength": 160},
    "state": {"enum": ["ACTIVE", "HOLD", "REDUCE_ONLY", "FLAT"]},
    "as_of": {"type": "string", "format": "date"},
    "latest_complete_date": {"type": "string", "format": "date"},
    "generated_at": {"type": "string", "format": "date-time"},
    "champion": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy_id", "strategy_version", "sha256"],
          "properties": {
            "strategy_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
            "strategy_version": {"type": "string", "pattern": "^v[0-9]+(?:\\.[0-9]+){0,2}$"},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          }
        }
      ]
    },
    "previous_signal_sha256": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/sha256"}
      ]
    },
    "target_positions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["symbol", "target_weight"],
        "properties": {
          "symbol": {"type": "string", "pattern": "^[0-9]{6}\\.(SZ|SH|BJ)$"},
          "target_weight": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
      "uniqueItems": true
    },
    "contract_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_manifest_sha256",
        "dataset_snapshot_sha256",
        "universe_snapshot_sha256",
        "champion_sha256",
        "cost_model_sha256",
        "market_rules_sha256",
        "execution_policy_sha256",
        "portfolio_risk_sha256",
        "code_sha256",
        "config_sha256",
        "lockfile_sha256"
      ],
      "properties": {
        "dataset_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "dataset_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "universe_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "champion_sha256": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/sha256"}
          ]
        },
        "cost_model_sha256": {"$ref": "#/$defs/sha256"},
        "market_rules_sha256": {"$ref": "#/$defs/sha256"},
        "execution_policy_sha256": {"$ref": "#/$defs/sha256"},
        "portfolio_risk_sha256": {"$ref": "#/$defs/sha256"},
        "code_sha256": {"$ref": "#/$defs/sha256"},
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "lockfile_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {"enum": ["HOLD", "REDUCE_ONLY"]}
        },
        "required": ["state"]
      },
      "then": {
        "properties": {
          "previous_signal_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {"const": "ACTIVE"}
        },
        "required": ["state"]
      },
      "then": {
        "properties": {
          "champion": {"type": "object"},
          "contract_set": {
            "properties": {
              "champion_sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {"const": "FLAT"}
        },
        "required": ["state"]
      },
      "then": {
        "properties": {
          "target_positions": {"maxItems": 0}
        }
      }
    }
  ]
}
