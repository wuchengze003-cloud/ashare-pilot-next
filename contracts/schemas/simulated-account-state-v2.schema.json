{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ashare-pilot.local/simulated-account-state/2.0.0",
  "title": "Simulated Account State v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id", "schema_version", "state_id", "account_id", "account_sequence",
    "as_of", "generated_at", "previous_state_sha256", "source_signal", "initial_cash",
    "cash", "market_value", "total_assets", "nav", "target_positions", "holdings",
    "trades", "skips", "contract_set"
  ],
  "properties": {
    "contract_id": {"const": "simulated-account-state"},
    "schema_version": {"const": "2.0.0"},
    "state_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,159}$"},
    "account_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"},
    "account_sequence": {"type": "integer", "minimum": 1},
    "as_of": {"type": "string", "format": "date"},
    "generated_at": {"type": "string", "format": "date-time"},
    "previous_state_sha256": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]
    },
    "source_signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal_id", "sequence", "state", "as_of", "sha256"],
      "properties": {
        "signal_id": {"type": "string", "minLength": 3},
        "sequence": {"type": "integer", "minimum": 1},
        "state": {"enum": ["ACTIVE", "HOLD", "REDUCE_ONLY", "FLAT"]},
        "as_of": {"type": "string", "format": "date"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "initial_cash": {"type": "number", "exclusiveMinimum": 0},
    "cash": {"type": "number", "minimum": 0},
    "market_value": {"type": "number", "minimum": 0},
    "total_assets": {"type": "number", "minimum": 0},
    "nav": {"type": "number", "minimum": 0},
    "target_positions": {"$ref": "#/$defs/target_positions"},
    "holdings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol", "shares", "locked_shares", "avg_cost", "last_price",
          "market_value", "target_weight", "last_buy_date", "valuation_frozen"
        ],
        "properties": {
          "symbol": {"$ref": "#/$defs/symbol"},
          "shares": {"type": "integer", "minimum": 1},
          "locked_shares": {"type": "integer", "minimum": 0},
          "avg_cost": {"type": "number", "exclusiveMinimum": 0},
          "last_price": {"type": "number", "exclusiveMinimum": 0},
          "market_value": {"type": "number", "exclusiveMinimum": 0},
          "target_weight": {"type": "number", "minimum": 0, "maximum": 1},
          "last_buy_date": {
            "oneOf": [{"type": "null"}, {"type": "string", "format": "date"}]
          },
          "valuation_frozen": {"type": "boolean"}
        }
      }
    },
    "trades": {
      "type": "array",
      "items": {"$ref": "#/$defs/trade"}
    },
    "skips": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["symbol", "side", "reason_code"],
        "properties": {
          "symbol": {"$ref": "#/$defs/symbol"},
          "side": {"enum": ["buy", "sell"]},
          "reason_code": {"type": "string", "pattern": "^[A-Z0-9_]+$"}
        }
      }
    },
    "contract_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "market_day_sha256", "dataset_snapshot_sha256", "cost_model_sha256",
        "market_rules_sha256", "execution_policy_sha256"
      ],
      "properties": {
        "market_day_sha256": {"$ref": "#/$defs/sha256"},
        "dataset_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "cost_model_sha256": {"$ref": "#/$defs/sha256"},
        "market_rules_sha256": {"$ref": "#/$defs/sha256"},
        "execution_policy_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "symbol": {"type": "string", "pattern": "^[0-9]{6}\\.(SZ|SH|BJ)$"},
    "target_positions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["symbol", "target_weight"],
        "properties": {
          "symbol": {"$ref": "#/$defs/symbol"},
          "target_weight": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "trade": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trade_date", "symbol", "side", "shares", "price", "gross_amount",
        "commission", "stamp_duty", "transfer_fee", "total_cost", "reason"
      ],
      "properties": {
        "trade_date": {"type": "string", "format": "date"},
        "symbol": {"$ref": "#/$defs/symbol"},
        "side": {"enum": ["buy", "sell"]},
        "shares": {"type": "integer", "minimum": 1},
        "price": {"type": "number", "exclusiveMinimum": 0},
        "gross_amount": {"type": "number", "exclusiveMinimum": 0},
        "commission": {"type": "number", "minimum": 0},
        "stamp_duty": {"type": "number", "minimum": 0},
        "transfer_fee": {"type": "number", "minimum": 0},
        "total_cost": {"type": "number", "minimum": 0},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"account_sequence": {"const": 1}},
        "required": ["account_sequence"]
      },
      "then": {"properties": {"previous_state_sha256": {"type": "null"}}},
      "else": {"properties": {"previous_state_sha256": {"$ref": "#/$defs/sha256"}}}
    },
    {
      "if": {
        "properties": {"source_signal": {"properties": {"state": {"const": "HOLD"}}}},
        "required": ["source_signal"]
      },
      "then": {"properties": {"trades": {"maxItems": 0}}}
    },
    {
      "if": {
        "properties": {
          "source_signal": {
            "properties": {"state": {"enum": ["REDUCE_ONLY", "FLAT"]}}
          }
        },
        "required": ["source_signal"]
      },
      "then": {
        "properties": {
          "trades": {
            "not": {
              "contains": {
                "properties": {"side": {"const": "buy"}},
                "required": ["side"]
              }
            }
          }
        }
      }
    }
  ]
}
