{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ashare-pilot.local/runtime-manifest/1.0.0",
  "title": "Runtime Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "schema_version",
    "run_id",
    "git_sha",
    "as_of",
    "generated_at",
    "inputs",
    "outputs"
  ],
  "properties": {
    "contract_id": {"const": "runtime-manifest"},
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "minLength": 3, "maxLength": 160},
    "git_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "as_of": {"type": "string", "format": "date"},
    "generated_at": {"type": "string", "format": "date-time"},
    "inputs": {"$ref": "#/$defs/artifacts"},
    "outputs": {"$ref": "#/$defs/artifacts"}
  },
  "$defs": {
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "sha256"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1, "maxLength": 160},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
