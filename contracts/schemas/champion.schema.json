{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ashare-pilot.local/champion/3.0.0",
  "title": "Champion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "schema_version",
    "strategy_id",
    "strategy_version",
    "adapter_id",
    "adapter_sha256",
    "promoted_at",
    "promotion_compatibility",
    "promotion_evidence",
    "fixed_contract_set",
    "promotion_report_sha256"
  ],
  "properties": {
    "contract_id": {"const": "champion"},
    "schema_version": {"const": "3.0.0"},
    "strategy_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "strategy_version": {"type": "string", "pattern": "^v[0-9]+(?:\\.[0-9]+){0,2}$"},
    "adapter_id": {"type": "string", "pattern": "^[a-z0-9-]+/v[0-9]+$"},
    "adapter_sha256": {"$ref": "#/$defs/sha256"},
    "promoted_at": {"type": "string", "format": "date-time"},
    "promotion_compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_family_id",
        "data_schema_sha256",
        "normalization_version",
        "universe_policy_id",
        "universe_policy_version"
      ],
      "properties": {
        "dataset_family_id": {"type": "string", "minLength": 3, "maxLength": 160},
        "data_schema_sha256": {"$ref": "#/$defs/sha256"},
        "normalization_version": {"type": "string", "minLength": 3, "maxLength": 80},
        "universe_policy_id": {"type": "string", "minLength": 3, "maxLength": 80},
        "universe_policy_version": {"type": "string", "minLength": 2, "maxLength": 40}
      }
    },
    "promotion_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_manifest_sha256",
        "dataset_snapshot_sha256",
        "universe_snapshot_sha256"
      ],
      "properties": {
        "dataset_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "dataset_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "universe_snapshot_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "fixed_contract_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cost_model_sha256",
        "market_rules_sha256",
        "execution_policy_sha256",
        "portfolio_risk_sha256",
        "code_sha256",
        "config_sha256",
        "lockfile_sha256"
      ],
      "properties": {
        "cost_model_sha256": {"$ref": "#/$defs/sha256"},
        "market_rules_sha256": {"$ref": "#/$defs/sha256"},
        "execution_policy_sha256": {"$ref": "#/$defs/sha256"},
        "portfolio_risk_sha256": {"$ref": "#/$defs/sha256"},
        "code_sha256": {"$ref": "#/$defs/sha256"},
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "lockfile_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "promotion_report_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
