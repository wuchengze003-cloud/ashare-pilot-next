{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ashare-pilot.local/champion/1.0.0",
  "title": "Champion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "schema_version",
    "strategy_id",
    "strategy_version",
    "adapter_id",
    "promoted_at",
    "code_sha256",
    "config_sha256",
    "dataset_id",
    "promotion_report_sha256"
  ],
  "properties": {
    "contract_id": {"const": "champion"},
    "schema_version": {"const": "1.0.0"},
    "strategy_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "strategy_version": {"type": "string", "pattern": "^v[0-9]+(?:\\.[0-9]+){0,2}$"},
    "adapter_id": {"type": "string", "pattern": "^[a-z0-9-]+/v[0-9]+$"},
    "promoted_at": {"type": "string", "format": "date-time"},
    "code_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "config_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "dataset_id": {"type": "string", "minLength": 3},
    "promotion_report_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
