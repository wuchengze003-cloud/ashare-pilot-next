{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ashare-pilot.local/dataset-manifest/1.0.0",
  "title": "Dataset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "schema_version",
    "dataset_id",
    "dataset_kind",
    "as_of",
    "generated_at",
    "source",
    "quality_status",
    "files"
  ],
  "properties": {
    "contract_id": {"const": "dataset-manifest"},
    "schema_version": {"const": "1.0.0"},
    "dataset_id": {"type": "string", "minLength": 3, "maxLength": 160},
    "dataset_kind": {"enum": ["raw", "normalized"]},
    "as_of": {"type": "string", "format": "date"},
    "generated_at": {"type": "string", "format": "date-time"},
    "source": {"type": "string", "minLength": 1, "maxLength": 80},
    "quality_status": {"enum": ["pass", "fail"]},
    "quality_reasons": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 160},
      "uniqueItems": true
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "row_count"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "row_count": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
